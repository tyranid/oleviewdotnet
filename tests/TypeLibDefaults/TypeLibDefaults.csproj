  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget Condition="'$(TestArchitecture)' != ''">$(TestArchitecture)</PlatformTarget>
    <OutputPath>bin\$(TestArchitecture)\$(Configuration)\</OutputPath>
